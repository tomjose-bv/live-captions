# Copy to .env (scripts/setup.ps1 does this for you). .env is git-ignored.
# Everything here is optional: captioning works with no configuration at all.

# --- Optional "Summarize" button -------------------------------------------
# Any OpenAI-compatible chat-completions server. Default: Ollama on this PC.
#   Install Ollama from https://ollama.com, then:  ollama pull llama3.2:3b
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.2:3b
# Only needed if your local server requires a key. Never commit a real key.
LLM_API_KEY=
# Seconds to wait for a summary (small CPU models can be slow on long transcripts).
LLM_TIMEOUT=180
